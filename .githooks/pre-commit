#!/usr/bin/env bash
set -euo pipefail


# Reject manual edits to auto-generated bindings
if [ "${SKIP_BINDINGS_CHECK:-}" != "1" ]; then
  bindings_files=$(git diff --cached --name-only -- bindings/ | grep -v '^bindings/README\.md$' || true)
  if [ -n "$bindings_files" ]; then
    echo "error: files in bindings/ are auto-generated and should not be modified manually:"
    echo "$bindings_files" | sed 's/^/  /'
    exit 1
  fi
fi

# Sync FFI crate versions to match their lib crates
result=$(./scripts/sync-ffi-versions.sh)
if [ -n "$result" ] && [ "$result" != "" ]; then
  echo "Pre-commit: synced FFI versions — staging updated files"
  git add crates/ffi/*/Cargo.toml Cargo.toml
fi

# Check that staged lib crate changes have corresponding FFI updates
if [ "${SKIP_FFI_COVERAGE:-}" != "1" ]; then
  ./scripts/check-ffi-coverage.sh --cached
fi

# Sync workspace dependency versions to match crate versions
result=$(./scripts/sync-workspace-versions.sh)
if [ "$result" = "updated" ]; then
  echo "Pre-commit: synced workspace dependency versions — staging Cargo.toml"
  git add Cargo.toml
fi

# Validate FFI crate versions >= lib crate versions
./scripts/check-ffi-versions.sh

# Validate workspace dependency versions match crate versions
./scripts/check-workspace-versions.sh
