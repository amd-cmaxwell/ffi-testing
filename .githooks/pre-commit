#!/usr/bin/env bash
set -euo pipefail

. "$(dirname "$0")/../scripts/log.sh"

trap 'log_error "pre-commit hook failed"; git status' ERR

# Reject manual edits to auto-generated bindings
if [ "${SKIP_BINDINGS_CHECK:-}" != "1" ]; then
  bindings_files=$(git diff --cached --name-only -- bindings/ | grep -v '^bindings/README\.md$' || true)
  if [ -n "$bindings_files" ]; then
    log_error "files in bindings/ are auto-generated and should not be modified manually:"
    echo "$bindings_files" | sed 's/^/  /'
    exit 1
  fi
fi

# Sync FFI crate versions to match their lib crates
result=$(./scripts/sync-ffi-versions.sh --cached)
if [ -n "$result" ] && [ "$result" != "" ]; then
  log_notice "Pre-commit: synced FFI versions — staging updated files"
  for crate_us in $result; do
    git add "crates/ffi/$(echo "$crate_us" | tr '_' '-')/Cargo.toml"
  done
  git add Cargo.toml
  git status
fi

# Check that staged lib crate changes have corresponding FFI updates
if [ "${SKIP_FFI_COVERAGE:-}" != "1" ]; then
  ./scripts/check-ffi-coverage.sh --cached
fi

# Sync workspace dependency versions to match crate versions
result=$(./scripts/sync-workspace-versions.sh --cached)
if [ "$result" = "updated" ]; then
  log_notice "Pre-commit: synced workspace dependency versions — staging Cargo.toml"
  git add Cargo.toml
  git status
fi

# Validate FFI crate versions >= lib crate versions
./scripts/check-ffi-versions.sh --cached

# Validate workspace dependency versions match crate versions
./scripts/check-workspace-versions.sh --cached
